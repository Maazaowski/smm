# Neon Postgres — for blog posts storage
# Create a free DB at neon.tech, then copy the connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis — for reactions, views, and analytics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin panel password
ADMIN_PASSWORD=

# Newsletter unsubscribe links. Each email carries /api/unsubscribe?e=<email>&t=<hmac>
# where t is HMAC-SHA256(lowercase email) under this secret, so one click is
# enough and nobody can forge a link for someone else's address. Any long random
# string; `openssl rand -hex 32` is fine. Rotating it invalidates every link in
# already-sent emails. When unset the endpoint answers 503 and the emails fall
# back to a mailto: link.
NEWSLETTER_SECRET=

# GitHub (projects sync)
# Fine-grained PAT, READ-ONLY, scoped to just the project repos.
# Permissions: Metadata:R, Contents:R, Actions:R, Pull requests:R
# Deliberately not named GITHUB_TOKEN — that name held a stale classic PAT.
GITHUB_SYNC_TOKEN=

# Vercel Cron shared secret. Vercel injects `Authorization: Bearer $CRON_SECRET`
# on scheduled invocations when this is set in the project environment.
CRON_SECRET=

# Vercel Blob — where essay images uploaded from the desk are stored.
# Create a Blob store on the Vercel project (Storage → Blob) and the token is
# added to the environment automatically. Locally, leave it empty and uploads
# land in public/uploads/ instead, which is git-ignored.
BLOB_READ_WRITE_TOKEN=
