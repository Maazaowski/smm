# Neon Postgres — for blog posts storage
# Create a free DB at neon.tech, then copy the connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis — for reactions, views, and analytics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin panel password
ADMIN_PASSWORD=

# GitHub (projects sync)
# Fine-grained PAT, READ-ONLY, scoped to just the project repos.
# Permissions: Metadata:R, Contents:R, Actions:R, Pull requests:R
# Deliberately not named GITHUB_TOKEN — that name held a stale classic PAT.
GITHUB_SYNC_TOKEN=

# Vercel Cron shared secret. Vercel injects `Authorization: Bearer $CRON_SECRET`
# on scheduled invocations when this is set in the project environment.
CRON_SECRET=
